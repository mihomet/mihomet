            <gradient
                android:startX="29"
                android:startY="34"
                android:endX="79"
                android:endY="74"
                android:type="linear">
                <item
                    android:offset="0.0"
                    android:color="#FFA78BFA" />
                <item
                    android:offset="1.0"
                    android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Entry node (teal) -->
    <path
        android:fillColor="#FF2DD4BF"
        android:pathData="M23.6,74 a5.4,5.4 0 1,0 10.8,0 a5.4,5.4 0 1,0 -10.8,0" />
