    <path
        android:fillColor="#FFF472B6"
        android:pathData="M73.6,74 a5.4,5.4 0 1,0 10.8,0 a5.4,5.4 0 1,0 -10.8,0" />
    <!-- Peak / valley relay nodes -->
    <path
