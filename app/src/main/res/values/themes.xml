<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mihomet" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen (androidx.core:core-splashscreen) with the brand glyph -->
    <style name="Theme.Mihomet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#17171A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Mihomet</item>
    </style>
</resources>
