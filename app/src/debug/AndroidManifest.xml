<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay: allow full cleartext HTTP in debug builds
  (local panel testing, http:// subscription sources). Merged only into
  debug variants; release keeps @xml/network_security_config.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />

</manifest>
